# =============================================================================
# Athena — local development environment
# Copy to `.env` and adjust. Full reference: docs/environment.md
# NEVER put real secrets in this file or in git.
# =============================================================================

# --- Application ---
ATHENA_APP_ENV=development              # development | staging | production
ATHENA_HTTP_ADDR=:8080                  # API listen address (inside container use :8080)
ATHENA_LOG_LEVEL=info                   # debug | info | warn | error
ATHENA_LOG_FORMAT=text                  # text | json
ATHENA_SHUTDOWN_TIMEOUT=15s

# --- PostgreSQL ---
POSTGRES_USER=athena
POSTGRES_PASSWORD=athena_dev_password
POSTGRES_DB=athena
POSTGRES_PORT=5432
ATHENA_DATABASE_URL=postgres://athena:athena_dev_password@localhost:5432/athena?sslmode=disable
ATHENA_DB_MAX_CONNS=20

# --- Redis ---
REDIS_PORT=6379
ATHENA_REDIS_ADDR=localhost:6379

# --- HTTP / CORS ---
ATHENA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Research providers ---
SEMANTICSCHOLAR_API_KEY=                # optional; raises Semantic Scholar rate limits
OPENALEX_MAILTO=you@example.com         # polite pool: identifies your requests to OpenAlex
ARXIV_USER_AGENT=athena-dev/0.1 (mailto:you@example.com)

# --- Ingestion workers ---
ATHENA_WORKER_CONCURRENCY=4
ATHENA_INGESTION_ENABLED=true

# --- AI providers (Phase 4) ---
LLM_PROVIDER=openai_compatible          # openai_compatible | anthropic | ollama
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Auth (Phase 5) ---
ATHENA_JWT_SECRET=change-me-32-bytes-minimum-secret!!
ATHENA_ADMIN_TOKEN=change-me-admin-token
