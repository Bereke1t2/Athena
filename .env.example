# =============================================================================
# Athena — local development environment
# Copy to `.env` and adjust. Full reference: docs/environment.md
# NEVER put real secrets in this file or in git.
# =============================================================================

# --- Application ---
ATHENA_APP_ENV=development              # development | staging | production
ATHENA_HTTP_ADDR=:8080                  # API listen address (inside container use :8080)
ATHENA_LOG_LEVEL=info                   # debug | info | warn | error
ATHENA_LOG_FORMAT=text                  # text | json
ATHENA_SHUTDOWN_TIMEOUT=15s

# --- PostgreSQL (Local Docker or Neon Serverless Postgres) ---
POSTGRES_USER=athena
POSTGRES_PASSWORD=athena_dev_password
POSTGRES_DB=athena
POSTGRES_PORT=5432
# Local dev default:
ATHENA_DATABASE_URL=postgres://athena:athena_dev_password@localhost:5432/athena?sslmode=disable
# Neon production example:
# ATHENA_DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
ATHENA_DB_MAX_CONNS=20

# --- Redis ---
REDIS_PORT=6379
ATHENA_REDIS_ADDR=localhost:6379

# --- HTTP / CORS ---
ATHENA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Research providers ---
SEMANTICSCHOLAR_API_KEY=                # optional; raises Semantic Scholar rate limits
OPENALEX_MAILTO=you@example.com         # polite pool: your personal/project email (no signup required)
ARXIV_USER_AGENT=athena-dev/0.1 (mailto:you@example.com)

# --- Ingestion workers ---
ATHENA_WORKER_CONCURRENCY=4
ATHENA_INGESTION_ENABLED=true

# --- AI providers (Phase 4) ---
# Option A: Google Gemini (Recommended if you have a Gemini API key)
LLM_PROVIDER=gemini                     # gemini | openai_compatible | stub
GEMINI_API_KEY=                         # your Google AI Studio API key
LLM_MODEL=gemini-3.5-flash-lite              # gemini-3.5-flash-lite | gemini-3.5-flash | gemini-3.6-flash
EMBEDDING_PROVIDER=gemini               # gemini (text-embedding-004) | openai_compatible | none (stub)
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# Option B: OpenAI / OpenAI-compatible
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=768

# --- Auth (Phase 5) ---
ATHENA_JWT_SECRET=change-me-32-bytes-minimum-secret!!
ATHENA_ADMIN_TOKEN=change-me-admin-token
