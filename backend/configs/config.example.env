# Runtime variables consumed by the athena binaries.
# Infra bootstrap vars (POSTGRES_*, REDIS_*) live in the repo-root .env.example.
# Full reference: docs/environment.md

ATHENA_APP_ENV=development
ATHENA_HTTP_ADDR=:8080
ATHENA_LOG_LEVEL=info
ATHENA_LOG_FORMAT=text
ATHENA_SHUTDOWN_TIMEOUT=15s

ATHENA_DATABASE_URL=postgres://athena:athena_dev_password@localhost:5432/athena?sslmode=disable
ATHENA_DB_MAX_CONNS=20
ATHENA_REDIS_ADDR=localhost:6379

SEMANTICSCHOLAR_API_KEY=
OPENALEX_MAILTO=you@example.com
ARXIV_USER_AGENT=athena-dev/0.1 (mailto:you@example.com)

ATHENA_WORKER_CONCURRENCY=4
ATHENA_INGESTION_ENABLED=true

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
